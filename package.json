{
  "name": "tastefit",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "format": "prettier --check .",
    "guard:self-lock": "tsx scripts/guard/self-lock.ts",
    "env:init": "tsx scripts/env/init-local.ts",
    "spec:extract": "tsx scripts/spec/extract.ts",
    "dev:stack": "tsx scripts/stack/dev-stack.ts",
    "db:native": "tsx scripts/stack/native-pg.ts",
    "db:reset": "tsx scripts/stack/native-pg.ts db-reset",
    "guard": "tsx scripts/guard/index.ts",
    "guard:count": "tsx scripts/guard/stages/count.ts",
    "qa:trace": "tsx scripts/qa/trace.ts",
    "verify:fast": "tsx scripts/verify/run.ts fast",
    "verify:m0": "tsx scripts/verify/run.ts m0",
    "verify:m1": "tsx scripts/verify/run.ts m1",
    "verify:m2": "tsx scripts/verify/run.ts m2",
    "verify:m3": "tsx scripts/verify/run.ts m3",
    "verify:m4": "tsx scripts/verify/run.ts m4",
    "verify:m5": "tsx scripts/verify/run.ts m5",
    "verify:m6": "tsx scripts/verify/run.ts m6",
    "verify:m7": "tsx scripts/verify/run.ts m7",
    "verify:m8": "tsx scripts/verify/run.ts m8",
    "data:validate": "tsx scripts/data/validate.ts",
    "seed:temp": "tsx scripts/data/seed-temp.ts",
    "db:seed": "tsx scripts/data/db-seed.ts",
    "db:types": "tsx scripts/data/db-types.ts",
    "db:schema-parity": "tsx scripts/data/schema-parity.ts",
    "db:grants-snapshot": "tsx scripts/data/grants-snapshot.ts",
    "survey:build": "tsx scripts/todo.ts survey:build M4",
    "eval:golden": "tsx scripts/todo.ts eval:golden M7",
    "release:check": "tsx scripts/todo.ts release:check M8",
    "fixtures:layouts": "tsx scripts/data/fixtures-layouts.ts",
    "eval:extractor:selfcheck": "tsx scripts/eval/extractor-selfcheck.ts",
    "eval:extractor": "tsx scripts/eval/extractor-eval.ts",
    "presets:lint-matrix": "tsx scripts/data/presets-lint-matrix.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tastefit/config": "workspace:^",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.0",
    "turbo": "^2.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  }
}
