{
  "name": "@tastefit/worker-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "dev": "tsx src/main.ts",
    "start:check-env": "tsx src/main.ts --check-env"
  },
  "dependencies": {
    "@tastefit/assets": "workspace:^",
    "@tastefit/config": "workspace:^",
    "@tastefit/db": "workspace:^",
    "@tastefit/design-spec": "workspace:^",
    "@tastefit/extractor": "workspace:^",
    "@tastefit/linter": "workspace:^",
    "@tastefit/renderer": "workspace:^",
    "@tastefit/scoring": "workspace:^",
    "pg-boss": "^12.0.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
