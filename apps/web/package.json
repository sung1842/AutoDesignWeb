{
  "name": "@tastefit/web-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "dev": "tsx src/check-env.ts && next dev -p 3000",
    "start:check-env": "tsx src/check-env.ts"
  },
  "dependencies": {
    "@tastefit/api-contract": "workspace:^",
    "@tastefit/auth": "workspace:^",
    "@tastefit/compliance": "workspace:^",
    "@tastefit/config": "workspace:^",
    "@tastefit/db": "workspace:^",
    "@tastefit/diagnosis": "workspace:^",
    "@tastefit/llm": "workspace:^",
    "@tastefit/mail": "workspace:^",
    "@tastefit/renderer": "workspace:^",
    "@tastefit/storage": "workspace:^",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.0"
  }
}
